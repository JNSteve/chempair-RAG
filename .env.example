OPENAI_API_KEY=your-openai-api-key-here
RAG_AUTH_REQUIRED=true
RAG_API_KEY=replace-with-a-long-random-token
RAG_ALLOWED_ORIGINS=http://localhost:5173
# Query-time answer model (default: gpt-5.4-mini). Set a more capable model
# id to improve answer quality at higher per-query cost, e.g. gpt-5.4.
# Ingestion (ingest_corpus.py) keeps its own cheaper model regardless.
RAG_LLM_MODEL=gpt-5.4-mini

# Structured edit proposals on /query answers (enviro-sage PR #612 contract).
# ON by default. Set to false as a kill-switch if proposals misbehave.
RAG_ENABLE_PROPOSALS=true
